{
  "app-id": "io.github.scarletnx.scarletnx",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm22"],
  "command": "scarletnx",
  "finish-args": [
    "--device-if=all:!has-input-device",
    "--device=input",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc"
  ],
  "modules": [
    {
      "name": "scarletnx",
      "buildsystem": "cmake",
      "builddir": true,
      "build-options": {
        "build-args": ["--share=network"],
        "append-path": "/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "strip": true,
        "no-debuginfo": true,
        "arch": {
          "x86_64": {
            "cflags": "-march=x86-64-v3 -mtune=generic -O3 -pipe",
            "cxxflags": "-march=x86-64-v3 -mtune=generic -O3 -pipe"
          },
          "aarch64": {
            "cflags": "-march=armv8-a -mtune=generic -O3 -pipe",
            "cxxflags": "-march=armv8-a -mtune=generic -O3 -pipe"
          }
        },
        "env": {
          "AR": "llvm-ar",
          "CC": "clang",
          "CXX": "clang++",
          "RANLIB": "llvm-ranlib"
        }
      },
      "config-opts": [
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSNX_BUILD_3DS=ON",
        "-DSNX_BUILD_VITA=ON"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/scarletnx/ScarletNX",
          "tag": "d9c500d6e2bfbc3e271c27bd62d7af923aaf4527",
          "commit": "d9c500d6e2bfbc3e271c27bd62d7af923aaf4527"
        }
      ]
    },
    {
      "name": "bootstrap",
      "buildsystem": "simple",
      "build-commands": [
        "mv /app/share/applications/scarletnx.desktop /app/share/applications/io.github.scarletnx.scarletnx.desktop",
        "desktop-file-edit --set-key=Icon --set-value=io.github.scarletnx.scarletnx /app/share/applications/io.github.scarletnx.scarletnx.desktop",
        "mv /app/share/icons/hicolor/16x16/apps/wimsy.png /app/share/icons/hicolor/16x16/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/22x22/apps/wimsy.png /app/share/icons/hicolor/22x22/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/24x24/apps/wimsy.png /app/share/icons/hicolor/24x24/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/32x32/apps/wimsy.png /app/share/icons/hicolor/32x32/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/48x48/apps/wimsy.png /app/share/icons/hicolor/48x48/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/64x64/apps/wimsy.png /app/share/icons/hicolor/64x64/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/128x128/apps/wimsy.png /app/share/icons/hicolor/128x128/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/256x256/apps/wimsy.png /app/share/icons/hicolor/256x256/apps/io.github.scarletnx.scarletnx.png",
        "mv /app/share/icons/hicolor/scalable/apps/wimsy.svg /app/share/icons/hicolor/scalable/apps/io.github.scarletnx.scarletnx.svg",
        "sed -i 's/scarletnx.desktop/io.github.scarletnx.scarletnx.desktop/g' /app/share/metainfo/io.github.scarletnx.scarletnx.metainfo.xml",
        "sed -i 's/wimsy/io.github.scarletnx.scarletnx/g' /app/share/metainfo/io.github.scarletnx.scarletnx.metainfo.xml"
      ]
    }
  ]
}

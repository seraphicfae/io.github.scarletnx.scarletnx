{
  "app-id": "io.github.scarletnx.scarletnx",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "scarletnx",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm23"],
  "rename-desktop-file": "scarletnx.desktop",
  "rename-icon": "wimsy",
  "cleanup": [
    "/include",
    "/share/cmake",
    "/share/pkgconfig",
    "/lib/cmake",
    "/lib/debug",
    "/lib/pkgconfig"
  ],
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=input",
    "--device-if=all:!has-input-device"
  ],
  "modules": [
    {
      "name": "spirv-headers",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KhronosGroup/SPIRV-Headers.git",
          "commit": "496543121ce6419f23d6fa5d7194ba66c36212d2"
        }
      ]
    },
    {
      "name": "spirv-tools",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DSPIRV-Headers_SOURCE_DIR=/app",
        "-DSPIRV_SKIP_TESTS=ON"
      ],
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KhronosGroup/SPIRV-Tools.git",
          "commit": "ef96ed763b43b59b33b31b362f09a02b729fa1c9"
        }
      ]
    },
    {
      "name": "scarletnx",
      "buildsystem": "cmake-ninja",
      "build-options": {
        "build-args": ["--share=network"],
        "append-path": "/usr/lib/sdk/llvm23/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm23/lib",
        "strip": true,
        "no-debuginfo": true,
        "arch": {
          "x86_64": {
            "cflags": "-march=x86-64-v3 -O3 -pipe",
            "cxxflags": "-march=x86-64-v3 -O3 -pipe"
          },
          "aarch64": {
            "cflags": "-march=armv8-a -O3 -pipe",
            "cxxflags": "-march=armv8-a -O3 -pipe"
          }
        }
      },
      "builddir": true,
      "config-opts": [
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSNX_BUILD_3DS=ON",
        "-DSNX_BUILD_VITA=ON",
        "-DSNX_BUILD_AGB=ON"
      ],
      "post-install": [
        "mkdir -p /app/lib",
        "cp /usr/lib/sdk/llvm23/lib/libLLVM.so.23.1 /app/lib/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/scarletnx/ScarletNX",
          "commit": "2d5ec80b53b5da4dde80ae2821e5edbe7804fd17"
        }
      ]
    }
  ]
}

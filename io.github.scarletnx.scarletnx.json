{
  "app-id": "io.github.scarletnx.scarletnx",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm22"],
  "command": "scarletnx",
  "rename-desktop-file": "scarletnx.desktop",
  "rename-icon": "wimsy",
  "finish-args": [
    "--device-if=all:!has-input-device",
    "--device=input",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network"
  ],
  "modules": [
    {
      "name": "scarletnx",
      "buildsystem": "cmake",
      "builddir": true,
      "build-options": {
        "build-args": ["--share=network"],
        "append-path": "/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "strip": true,
        "no-debuginfo": true,
        "arch": {
          "x86_64": {
            "cflags": "-march=x86-64-v3 -mtune=generic -O3 -pipe",
            "cxxflags": "-march=x86-64-v3 -mtune=generic -O3 -pipe"
          },
          "aarch64": {
            "cflags": "-march=armv8-a -mtune=generic -O3 -pipe",
            "cxxflags": "-march=armv8-a -mtune=generic -O3 -pipe"
          }
        },
        "env": {
          "AR": "llvm-ar",
          "CC": "clang",
          "CXX": "clang++",
          "RANLIB": "llvm-ranlib"
        }
      },
      "config-opts": [
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSNX_BUILD_3DS=ON",
        "-DSNX_BUILD_VITA=ON"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/scarletnx/ScarletNX",
          "tag": "fd86bc425ae856ea75ef8001ffe3f53f6c07eea2",
          "commit": "fd86bc425ae856ea75ef8001ffe3f53f6c07eea2"
        }
      ]
    }
  ]
}
